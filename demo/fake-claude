#!/usr/bin/env python3
"""Stand-in for `claude` in the demo: shows what got resumed, then waits."""
import glob, json, os, sys

args = sys.argv[1:]
sid = args[args.index("--resume") + 1] if "--resume" in args else None
title, last, branch = "", "", None
for path in glob.glob(os.path.expanduser(f"~/.claude/projects/*/{sid}.jsonl")):
    for line in open(path):
        r = json.loads(line)
        if r.get("type") == "ai-title":
            title = r["aiTitle"]
        elif r.get("type") == "user":
            last = r["message"]["content"]
            branch = r.get("gitBranch")

cwd = os.getcwd().replace(os.path.expanduser("~"), "~", 1)
O, D, B, R = "\033[38;2;217;119;87m", "\033[2m", "\033[1m", "\033[0m"
print()
print(f"  {O}✻{R} {B}claude{R} {D}--resume {sid[:8]}…{R}")
print()
print(f"  {B}{title}{R}")
print(f"  {D}{cwd}{'  ·  ' + branch if branch else ''}{R}")
print()
print(f"  {D}last prompt{R}")
print(f"  {O}›{R} {last}")
print()
try:
    input(f"  {O}>{R} ")
except (KeyboardInterrupt, EOFError):
    print()
